# Build-time environment for the production (beta) build.
#
# Only VITE_-prefixed values reach the client bundle, and they are inlined at
# BUILD time — wrangler vars never reach import.meta.env, which is why the DSN
# has to live here as well as in wrangler.jsonc.
#
# A Sentry DSN is not a secret. It is embedded in every client bundle by design;
# it only permits event ingestion, never reads. Hence committed. See wt-3yb.
VITE_SENTRY_DSN=https://b709a5bb4e96c621ab3267a5efc1dbfa@o177762.ingest.us.sentry.io/4511848703918080

# Set by Task 9 (wt-ksh.1.9), once the production Convex deployment exists:
#   VITE_CONVEX_URL=https://<deployment>.convex.cloud
