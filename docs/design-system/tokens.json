{
  "$comment": "Wordle Teams design tokens. v1 = values read from cdub615/wordle-teams@main. v2 = proposed normalized set. HSL strings are bare triplets, matching the app's convention of hsl(var(--token)).",
  "meta": {
    "repo": "cdub615/wordle-teams",
    "branch": "main",
    "captured": "2026-08-03",
    "stack": "Next.js + Tailwind + shadcn/ui (default style, baseColor neutral, cssVariables true)",
    "themes": ["light", "dark"],
    "themeMechanism": ".dark class on <html> via next-themes"
  },

  "v1": {
    "color": {
      "background":              { "light": "0 0% 97%",       "dark": "0 0% 3.9%",      "lightHex": "#f7f7f7", "darkHex": "#0a0a0a" },
      "foreground":              { "light": "240 10% 0.9%",   "dark": "0 0% 98%",       "lightHex": "#020203", "darkHex": "#fafafa" },
      "card":                    { "light": "0 0% 97%",       "dark": "0 0% 3.9%",      "lightHex": "#f7f7f7", "darkHex": "#0a0a0a" },
      "card-foreground":         { "light": "240 10% 0.9%",   "dark": "0 0% 98%",       "lightHex": "#020203", "darkHex": "#fafafa" },
      "popover":                 { "light": "0 0% 97%",       "dark": "0 0% 3.9%",      "lightHex": "#f7f7f7", "darkHex": "#0a0a0a" },
      "popover-foreground":      { "light": "240 10% 0.9%",   "dark": "0 0% 98%",       "lightHex": "#020203", "darkHex": "#fafafa" },
      "muted":                   { "light": "240 4.8% 92.9%", "dark": "0 0% 14.9%",     "lightHex": "#ececee", "darkHex": "#262626" },
      "muted-foreground":        { "light": "240 3.8% 43.1%", "dark": "0 0% 63.9%",     "lightHex": "#6a6a72", "darkHex": "#a3a3a3" },
      "secondary":               { "light": "240 4.8% 92.9%", "dark": "0 0% 14.9%",     "lightHex": "#ececee", "darkHex": "#262626" },
      "secondary-foreground":    { "light": "240 5.9% 7%",    "dark": "0 0% 98%",       "lightHex": "#111113", "darkHex": "#fafafa" },
      "accent":                  { "light": "240 4.8% 92.9%", "dark": "0 0% 14.9%",     "lightHex": "#ececee", "darkHex": "#262626" },
      "accent-foreground":       { "light": "240 5.9% 7%",    "dark": "0 0% 98%",       "lightHex": "#111113", "darkHex": "#fafafa" },
      "border":                  { "light": "240 5.9% 87%",   "dark": "0 0% 14.9%",     "lightHex": "#dcdce0", "darkHex": "#262626" },
      "input":                   { "light": "240 5.9% 87%",   "dark": "0 0% 14.9%",     "lightHex": "#dcdce0", "darkHex": "#262626" },
      "primary":                 { "light": "240 5.9% 7%",    "dark": "0 0% 98%",       "lightHex": "#111113", "darkHex": "#fafafa" },
      "primary-foreground":      { "light": "0 0% 95%",       "dark": "0 0% 9%",        "lightHex": "#f2f2f2", "darkHex": "#171717" },
      "destructive":             { "light": "0 84.2% 57.2%",  "dark": "0 62.8% 30.6%",  "lightHex": "#ee3636", "darkHex": "#7f1d1d" },
      "destructive-foreground":  { "light": "0 0% 95%",       "dark": "0 85.7% 97.3%",  "lightHex": "#f2f2f2", "darkHex": "#fef2f2" },
      "ring":                    { "light": "142 76% 34%",    "dark": "142 69% 36%",    "lightHex": "#159945", "darkHex": "#1c9b4b" },
      "color-stop-1":            { "light": "142 76% 37%",    "dark": "142 76% 37%",    "lightHex": "#16a34a", "darkHex": "#16a34a" },
      "color-stop-2":            { "light": "119 65% 75%",    "dark": "119 65% 75%",    "lightHex": "#97e996", "darkHex": "#97e996" },
      "color-stop-3":            { "light": "49 91% 52%",     "dark": "49 91% 52%",     "lightHex": "#f4cb15", "darkHex": "#f4cb15" }
    },
    "hardcodedAccents": {
      "$comment": "Tailwind utilities applied inline in components. These are what v2 promotes to tokens.",
      "green-600":  { "hex": "#16a34a", "usedFor": ["correct tile (light)", "success badge", "logo gradient start", "border-beam colorFrom"] },
      "green-700":  { "hex": "#15803d", "usedFor": ["correct tile (dark)"] },
      "green-500":  { "hex": "#22c55e", "usedFor": ["wordmark gradient via (light)"] },
      "green-300":  { "hex": "#86efac", "usedFor": ["wordmark gradient via (dark)"] },
      "yellow-400": { "hex": "#facc15", "usedFor": ["present tile (light)", "logo gradient end", "border-beam colorTo"] },
      "yellow-500": { "hex": "#eab308", "usedFor": ["present tile (dark)"] },
      "gray-50":    { "hex": "#f9fafb", "usedFor": ["feature card heading on inverted band"] },
      "gray-400":   { "hex": "#9ca3af", "usedFor": ["feature card body on inverted band"] }
    },
    "radius": {
      "$base": "0.5rem",
      "sm": "4px", "md": "6px", "lg": "8px", "xl": "12px", "full": "9999px",
      "usage": { "button": "md", "input": "md", "select": "md", "card": "lg", "dialog": "lg", "skeleton": "md→lg/xl per slot", "badge": "full", "avatar": "full", "wordleTile": "0" }
    },
    "spacing": {
      "$comment": "Tailwind 4px step scale; the app uses a small vocabulary of it.",
      "inUse": { "2": "8px", "4": "16px", "6": "24px", "12": "48px" },
      "usage": {
        "pagePadding": "p-2 md:p-12",
        "gridGap": "gap-2 md:gap-6",
        "cardPadding": "px-4 py-6 md:p-6",
        "appBarPadding": "px-4 py-2 md:px-12 md:py-6",
        "wordleTileGap": "gap-1 (4px)"
      }
    },
    "typography": {
      "families": {
        "body": { "name": "Inter", "loader": "next/font", "subset": "latin", "appliedTo": "<body>", "weights": [400, 500, 600, 700] },
        "display": { "name": "Geist Sans", "appliedTo": "marketing headings, per-element className" }
      },
      "scale": {
        "text-xs":   { "size": "12px", "lineHeight": "16px", "usage": "Footer legal, N/A cells, mobile table text" },
        "text-sm":   { "size": "14px", "lineHeight": "20px", "usage": "Buttons, table body, card descriptions, toasts" },
        "text-base": { "size": "16px", "lineHeight": "24px", "usage": "Inputs, list rows, hero subhead on mobile" },
        "text-lg":   { "size": "18px", "lineHeight": "28px", "usage": "Dialog titles, error headline" },
        "text-2xl":  { "size": "24px", "lineHeight": "32px", "usage": "Card titles, app bar wordmark, empty-state heading" },
        "text-3xl":  { "size": "30px", "lineHeight": "36px", "usage": "Wordle tiles (mobile), desktop wordmark, mobile hero" },
        "text-4xl":  { "size": "36px", "lineHeight": "40px", "usage": "Wordle tiles (desktop), welcome headline" },
        "text-6xl":  { "size": "60px", "lineHeight": "60px", "usage": "Marketing hero h1 from md up (Geist)" }
      }
    },
    "elevation": {
      "shadow-sm": { "value": "0 1px 2px 0 rgb(0 0 0 / 0.05)", "usage": "Card, active tab" },
      "shadow-md": { "value": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)", "usage": "Select, dropdown" },
      "shadow-lg": { "value": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)", "usage": "Dialog, sheet, toast, switch thumb" }
    },
    "motion": {
      "accordion-down/up": { "timing": "0.2s ease-out", "where": "Radix accordion content height" },
      "overlays":          { "timing": "200ms fade + zoom-95 + slide", "where": "Dialog, sheet, select, popover via tailwindcss-animate" },
      "animate-pulse":     { "timing": "2s cubic-bezier(.4,0,.6,1) infinite", "where": "Skeletons, loading table, route loading" },
      "border-beam":       { "timing": "15s linear, offset-path", "where": "Dashboard screenshot on home", "params": { "size": 200, "borderWidth": 1.5, "colorFrom": "#16a34a", "colorTo": "#facc15" } },
      "animate-gradient":  { "timing": "8s linear infinite", "where": "Animated gradient text on first-run intro" },
      "shimmer":           { "timing": "8s infinite", "where": "Magic UI shimmer button" },
      "spin-slow":         { "timing": "3s linear infinite", "where": "Decorative spinners" },
      "spin-super-slow":   { "timing": "5s linear infinite", "where": "Decorative spinners" },
      "caret-blink":       { "timing": "1.25s ease-out infinite", "where": "OTP input caret" },
      "transition-colors": { "timing": "150ms", "where": "Every button, table row hover, tab" },
      "hero":              { "timing": "0.5s cubic-bezier(.4,0,.2,1); highlight sweep 2s at 0.5s delay", "where": "Home headline, framer-motion" }
    },
    "iconography": {
      "library": "lucide-react (a few @radix-ui/react-icons on home)",
      "strokeWidth": 2,
      "color": "currentColor",
      "sizes": { "16": "inline in text", "20": "in buttons", "22": "icon buttons", "40-48": "marketing feature icons" },
      "note": "Button variants force size-4 on any nested svg. Destructive icon actions use text-red-500 (#ee3636)."
    }
  },

  "v2": {
    "$comment": "Proposed. Three layers: primitives (raw ramps, never used directly), semantics (below), and shadcn aliases (see globals.v2.css) so existing ui/* compiles unchanged.",
    "surface": {
      "background":      { "light": "#fafafa", "dark": "#0a0a0a", "use": "Page. Normalized onto the neutral ramp (was 0 0% 97% / 0 0% 3.9%)" },
      "surface":         { "light": "#ffffff", "dark": "#121212", "use": "Cards, dialogs, popovers, sheets — a half step off the page" },
      "surface-sunken":  { "light": "#f4f4f5", "dark": "#1c1c1c", "use": "Table headers, tab tracks, skeletons, absent tiles" },
      "surface-inverse": { "light": "#18181b", "dark": "#fafafa", "use": "Marketing feature band; replaces bg-secondary-foreground" },
      "text":            { "light": "#0a0a0b", "dark": "#fafafa", "use": "Primary copy. Replaces the one-off 240 10% 0.9%" },
      "text-muted":      { "light": "#71717a", "dark": "#a3a3a3", "use": "Descriptions, table headers, footer" },
      "text-subtle":     { "light": "#9f9fa8", "dark": "#737373", "use": "N/A cells, timestamps, placeholders" },
      "border-subtle":   { "light": "#e4e4e7", "dark": "#292929", "use": "Default hairline — cards, tiles, table rows" },
      "border-strong":   { "light": "#c9c9cf", "dark": "#424242", "use": "Inputs, empty tiles, anything interactive" }
    },
    "accent": {
      "brand-from":         { "light": "#16a34a", "dark": "#16a34a", "use": "Wordmark gradient start, beam start" },
      "brand-via":          { "light": "#22c55e", "dark": "#86efac", "use": "Wordmark midpoint — already forks by theme today" },
      "brand-to":           { "light": "#facc15", "dark": "#facc15", "use": "Wordmark end, beam end" },
      "accent":             { "light": "#16a34a", "dark": "#22c55e", "use": "Focus ring, links, active nav. Replaces --ring" },
      "accent-foreground":  { "light": "#ffffff", "dark": "#052e16", "use": "Text on a filled accent" },
      "success":            { "light": "#16a34a", "dark": "#15803d", "use": "Winner badge, saved toast" },
      "success-foreground": { "light": "#ffffff", "dark": "#f0fdf4", "use": "Fixes the light-mode success badge contrast bug" },
      "warning":            { "light": "#facc15", "dark": "#eab308", "use": "Close / partial states, trial ending" },
      "warning-foreground": { "light": "#111113", "dark": "#111113", "use": "Yellow never takes light text, in either theme" },
      "danger":             { "light": "#dc2626", "dark": "#ef4444", "use": "Destructive actions. Dark was #7f1d1d — read as disabled" },
      "danger-foreground":  { "light": "#ffffff", "dark": "#ffffff", "use": "Text on a filled danger surface" }
    },
    "game": {
      "wordle-correct":     { "light": "#16a34a", "dark": "#15803d", "use": "Correct tile fill" },
      "wordle-present":     { "light": "#facc15", "dark": "#eab308", "use": "Present tile fill" },
      "wordle-absent":      { "light": "#f4f4f5", "dark": "#1c1c1c", "use": "Absent tile — aliases surface-sunken" },
      "wordle-tile-border": { "light": "#c9c9cf", "dark": "#424242", "use": "Empty tile outline — aliases border-strong" }
    },
    "rules": [
      "No Tailwind color utility in a component. If green-600 appears outside the token file, it is a missing token.",
      "Background and foreground travel together. Never set one without the other from the same pair.",
      "One accent per surface. Green earns attention, yellow means close, nothing else is saturated."
    ]
  }
}
