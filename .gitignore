# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# service worker, generated by serwist on every build (next.config.js swDest).
# It was tracked, so any `next build` left the tree dirty with a rewritten
# precache manifest and fresh Sentry debug ids — enough to block a rebase and to
# get swept into unrelated commits. The committed copy was stale anyway: recent
# app changes never updated it. `next build` regenerates both files and
# `next start` serves /sw.js from them, so nothing needs the checked-in version.
/public/sw.js
/public/sw.js.map

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Sentry Auth Token
.sentryclirc

# Sentry Config File
.env.sentry-build-plugin

.specstory/*

.cursor/*
.env*

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# One-off production remediation scripts. These hardcode real user email
# addresses, and this repo is public — never commit them.
scripts/*-prod.mjs

# v2 replatform build output. v2/ holds tracked SOURCE on feat/v2-replatform
# (guarded by its own v2/.gitignore), but on other branches only these
# artifacts are left behind on disk — and v2/.gitignore isn't checked out to
# suppress them. List the artifacts explicitly: a blanket `v2/` here would
# silently ignore new v2 source files once that branch merges.
v2/node_modules/
v2/dist/
v2/test-results/
v2/.convex/
v2/.tanstack/
v2/.wrangler/
v2/.output/

# superpowers brainstorm session artifacts
.superpowers/
